# Venture GP Atlas — Django backend environment
# Copy to .env for local development. NEVER commit .env.

SECRET_KEY=replace-with-openssl-rand-hex-32
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app

# Railway's PostgreSQL add-on injects this automatically (reference ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://postgres:password@localhost:5432/atlas

# Frontend origin(s), comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://venture-gp-atlas-frontend.up.railway.app

# First admin account, created on boot if missing
DJANGO_SUPERUSER_EMAIL=you@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-to-a-long-password

# Shared secret for the weekly refresh job (X-Import-Token header). openssl rand -hex 32
IMPORT_TOKEN=

# Set to 1 for one deploy to reload data/tracker.json over the live data
FORCE_REIMPORT=0
